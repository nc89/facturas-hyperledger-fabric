          "raw": "{\n  \"tokenId\": \"{{token_id}}\",\n  \"numero\": \"FAC-2025-0001\",\n  \"receptorId\": \"Org2MSP\",\n  \"moneda\": \"COP\",\n  \"montoTotal\": 1200000,\n  \"hashPDF\": \"sha256:abc123...\",\n  \"privateData\": {\n    \"items\": [\n      {\"descripcion\": \"Servicio consultoría\", \"cantidad\": 1, \"precioUnit\": 1200000}\n    ],\n    \"observaciones\": \"Proyecto piloto DIAN\",\n    \"metadata\": {\"radicadoDIAN\": \"1234567890\"}\n  }\n}"
