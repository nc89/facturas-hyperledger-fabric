# Versiones
FABRIC_VERSION=2.5.5
CA_VERSION=1.5
COMPOSE_PROJECT_NAME=facturas

# Canal
CHANNEL_NAME=facturas-channel

# Nombres y puertos
ORDERER_NAME=orderer.example.com
ORDERER_PORT=7050

ORG1_NAME=org1.example.com
ORG1_MSP=Org1MSP
ORG1_PEER0_NAME=peer0.org1.example.com
ORG1_PEER0_PORT=7051
ORG1_COUCH_PORT=5984

ORG2_NAME=org2.example.com
ORG2_MSP=Org2MSP
ORG2_PEER0_NAME=peer0.org2.example.com
ORG2_PEER0_PORT=9051
ORG2_COUCH_PORT=6984

# Rutas internas (persistidas en el host)
CRYPTO_DIR=./config/organizations
ARTIFACTS_DIR=./channel-artifacts

# Chaincode
CC_NAME=nftinvoice
CC_LANG=typescript
CC_VERSION=1.4
CC_SEQUENCE=5
CC_SRC_PATH=./chaincode/nftinvoice-typescript
CC_COLL_CONFIG=./collections/collections_config.json

# Política de endoso (doble validación)
CC_END_POLICY="AND('Org1MSP.peer','Org2MSP.peer')"

# Credenciales CouchDB (mismas para ambas, o pon distintas si prefieres)
COUCH_USER=admin
COUCH_PASSWORD=adminpw

ORDERER_ADMIN_PORT=9443
ORDERER_OPERATIONS_PORT=9446
